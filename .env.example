# ---------------------------------------------------------------------------
# Faceless Video Generator - environment variables
# Copy this file to ".env" and fill in your own credentials:
#     cp .env.example .env
# ---------------------------------------------------------------------------

# Required: OpenAI API configuration for story generation and text-to-speech.
# OPENAI_BASE_URL is optional if you use the official OpenAI endpoint; set it
# when routing through a proxy or an OpenAI-compatible provider.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key

# Required when the image provider is "replicate" (the default).
REPLICATE_API_TOKEN=your_replicate_api_token

# Required when the image provider is "fal".
# Select the provider in config.json -> image_generation.provider,
# or override it at runtime with:  faceless-gen --provider fal
FAL_KEY=your_fal_api_key
